{
  "extends": "astro/tsconfigs/strictest",
  "include": ["src"],
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true
  }
}
